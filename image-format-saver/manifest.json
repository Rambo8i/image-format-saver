{
  "manifest_version": 3,
  "name": "Image Format Saver",
  "version": "1.2.1",
  "description": "Speichert Bilder per Rechtsklick lokal als PNG, JPG, WebP oder PDF.",
  "minimum_chrome_version": "116",
  "permissions": [
    "contextMenus",
    "downloads",
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Image Format Saver",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
